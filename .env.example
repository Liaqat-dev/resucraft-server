# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Comma-separated hosts/IPs allowed as mobile app origins
MOBILE_ORIGINS=192.168.0.10

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/resucraft

# JWT Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_secret_here

# Email Provider: gmail | resend | brevo
EMAIL_PROVIDER=brevo
APP_NAME=ResuCraft
# Sender address (used by all providers); also the contact-form fallback recipient
EMAIL_USER=you@example.com
# Optional: where contact-form notifications are sent
# CONTACT_NOTIFY_EMAIL=you@example.com

# Gmail SMTP (used when EMAIL_PROVIDER=gmail; EMAIL_PASS is a Google app password)
# EMAIL_PASS=your_gmail_app_password

# Resend (used when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=noreply@yourdomain.com   # must be a verified domain on Resend

# Brevo (used when EMAIL_PROVIDER=brevo)
BREVO_API_KEY=your_brevo_api_key_here

# Image hosting (ImgBB)
IMGBB_API_KEY_V1=your_imgbb_api_key_here

# AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
